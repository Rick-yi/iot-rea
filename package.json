{
  "name": "iot-rea",
  "version": "0.6.0",
  "description": "Evidence-first reverse engineering for IoT captures, signals and firmware",
  "license": "MIT",
  "author": "Rick-yi",
  "keywords": [
    "iot",
    "reverse-engineering",
    "protocol-analysis",
    "pcap",
    "firmware",
    "uf2",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rick-yi/iot-rea.git"
  },
  "bugs": {
    "url": "https://github.com/Rick-yi/iot-rea/issues"
  },
  "homepage": "https://github.com/Rick-yi/iot-rea#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "iot-rea": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
